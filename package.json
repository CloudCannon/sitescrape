{
  "name": "sitescrape",
  "description": "A tool to download any site into a local static site",
  "version": "0.0.1",
  "main": "lib/index.js",
  "bin": "lib/index.js",
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=18.0.0"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "files": [
    "lib/**/*.js"
  ],
  "type": "module",
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@prettier/plugin-xml": "^3.2.0",
    "prettier": "^3.0.3",
    "jsdom": "^28.1.0",
    "srcset": "^5.0.0",
    "turndown": "^7.1.2",
    "yaml": "^2.2.1"
  },
  "scripts": {
    "publish": "npm run build && np",
    "test": "c8 tsx --test test/parsers.ts",
    "build": "tsc",
    "start": "tsc && node lib/index.js",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' 'test/**/*.ts' --write"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.0",
    "prettier": "^3.0.3",
    "c8": "^11.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudCannon/sitescrape.git"
  },
  "author": "CloudCannon",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CloudCannon/sitescrape/issues"
  },
  "homepage": "https://github.com/CloudCannon/sitescrape#readme"
}
